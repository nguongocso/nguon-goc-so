# ============================================================
# Frontend environment variables (Vite)
# ============================================================
# LOCAL DEVELOPMENT ONLY.
#
# In production the API base URL is resolved at RUNTIME from
# /config.js (see src/config/runtimeConfig.ts), which is populated
# by the container entrypoint from the API_BASE_URL env var.
# Nginx then reverse-proxies /api -> backend service.
#
# Leave this empty in any non-local environment to fall back to the
# same-origin default "/api/v1".
# ============================================================

# Base URL of the backend API during local development.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Mock kết quả kiểm nghiệm trên trang tra cứu công khai
# (CV-04, GET /public/trace/{codeValue}/inspections).
# Mặc định =false (mock TẮT): frontend gọi API thật; nếu backend chưa
# có endpoint thì UI hiển thị "Chưa có kết quả kiểm nghiệm".
# Chỉ bật =true khi cần demo/dev mà backend chưa sẵn sàng.
# Màn hình ghi kết quả kiểm nghiệm dùng API thật của backend
# (GET /inspection-requests/{requestId}, PUT /inspection-requests/{requestId}/results).
VITE_USE_MOCK_INSPECTION_RESULT=false

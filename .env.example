# =========================
# DATABASE
# =========================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=nguon_goc_so
DB_USERNAME=nguongocso
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# =========================
# SERVER
# =========================
PORT=8080
VITE_API_URL=http://localhost:8080

# =========================
# JWT
# =========================
JWT_SECRET=
JWT_EXPIRATION=86400000

# =========================
# CORS
# =========================
ALLOWED_ORIGINS=http://localhost:3000

# =========================
# UPLOAD
# =========================
UPLOAD_BASE_DIR=/app/uploads
UPLOAD_FARM_LOG_RELATIVE_PATH=farm-logs
UPLOAD_FARM_LOG_MAX_SIZE=5242880

# =========================
# QR CODE
# =========================
QR_IMAGE_STORAGE_PATH=/app/files/qr

# =========================
# MYSQL BACKUP / RESTORE
# =========================
MYSQL_DUMP_PATH=/usr/bin/mysqldump
MYSQL_PATH=/usr/bin/mysql

# =========================
# FRONTEND
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# MAIL - GMAIL SMTP
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# =========================
# LOCATIONIQ
# =========================
LOCATIONIQ_API_KEY=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1/reverse

# =========================
# DOCKER / FRONTEND
# =========================
FRONTEND_CONTAINER_PORT=80
FRONTEND_HOST_PORT=3000

# =========================
# DOCKER / BACKEND
# =========================
BACKEND_CONTAINER_PORT=8080
BACKEND_HOST_PORT=8080

# =========================
# DOCKER / MYSQL
# =========================
MYSQL_CONTAINER_PORT=3306
MYSQL_HOST_PORT=3306

# =========================
# JAVA
# =========================
JAVA_OPTS=-Xms256m -Xmx768m

# =========================
# BUSINESS TIMEZONE
# =========================
# Múi giờ nghiệp vụ dùng chung cho toàn hệ thống (Clock nghiệp vụ và múi giờ
# mặc định của JVM). Mặc định Asia/Ho_Chi_Minh nếu không khai báo.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# =========================
# DOCKER VOLUMES
# =========================
MYSQL_VOLUME_NAME=nguongocso_mysql_data
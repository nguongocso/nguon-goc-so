							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Rejected with 400\", () => pm.expect(pm.response.code).to.eql(400));",
									"const body = pm.response.json();",
									"pm.test(\"Error message mentions duplicate name\", () => {",
									"    pm.expect(body.message || '').to.include('tồn tại');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json; charset=utf-8" }
						],
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"Postman Test Lab\",\n    \"accreditationCode\": \"PM-TEST-002\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/v1/testing-units", "host": ["{{baseUrl}}"], "path": ["api", "v1", "testing-units"] }
					}
				},
				{
					"name": "06. Create Missing Name (Validation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Rejected with 400\", () => pm.expect(pm.response.code).to.eql(400));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json; charset=utf-8" }
						],
						"body": { "mode": "raw", "raw": "{\n    \"accreditationCode\": \"PM-NO-NAME\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/v1/testing-units", "host": ["{{baseUrl}}"], "path": ["api", "v1", "testing-units"] }
					}
				},
				{
					"name": "07. Get All Testing Units (Paged)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"Response is paginated\", () => {",
									"    pm.expect(body.data.items).to.be.an('array');",
									"    pm.expect(body.data).to.have.property('totalElements');",
									"    pm.expect(body.data).to.have.property('totalPages');",
									"});",
									"pm.test(\"totalElements >= 7 seed units\", () => pm.expect(body.data.totalElements).to.be.at.least(7));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/testing-units?page=0&size=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "testing-units"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "20" }
							]
						}
					}
				},
				{
					"name": "08. Get Active Units Only (?isActive=true)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const items = pm.response.json().data.items;",
									"pm.test(\"All items have isActive = true\", () => {",
									"    pm.expect(items.length).to.be.above(0);",
									"    items.forEach((u) => pm.expect(u.isActive, u.name).to.eql(true));",
									"});",
									"pm.test(\"Inactive seed units are excluded\", () => {",
									"    const codes = items.map((u) => u.accreditationCode);",
									"    pm.expect(codes).to.not.include('EXP-006');",
									"    pm.expect(codes).to.not.include('INACTIVE-007');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/testing-units?isActive=true&page=0&size=50",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "testing-units"],
							"query": [
								{ "key": "isActive", "value": "true" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "50" }
							]
						}
					}
				},
				{
					"name": "09. Pagination - Page 0 (size=2)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Page 0 returns at most 2 items\", () => {",
									"    const d = pm.response.json().data;",
									"    pm.expect(d.items.length).to.be.at.most(2);",
									"    pm.expect(d.first).to.eql(true);",
									"});",
									"pm.environment.set(\"page0FirstId\", pm.response.json().data.items[0].id);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/testing-units?page=0&size=2",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "testing-units"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "2" }
							]
						}
					}
				},
				{
					"name": "10. Pagination - Page 1 differs from Page 0",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const d = pm.response.json().data;",
									"const page0Id = pm.environment.get(\"page0FirstId\");",
									"pm.test(\"Page 1 has items and different first id\", () => {",
									"    pm.expect(d.first).to.eql(false);",
									"    if (d.items.length > 0) {",
									"        pm.expect(d.items[0].id).to.not.eql(page0Id);",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/testing-units?page=1&size=2",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "testing-units"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "size", "value": "2" }
							]
						}
					}

{
	"info": {
		"_postman_id": "b7e1c2d4-0060-4a11-9f22-ncl11cn006p1",
		"name": "NCL-11-CN-006 - Testing Units API (Phase 1)",
		"description": "Bộ test tự động cho API danh mục đơn vị kiểm nghiệm dùng chung.\n\nChạy theo thứ tự các request trong collection (mỗi request phụ thuộc biến môi trường do request trước lưu lại).\n\nLưu ý:\n- Đăng nhập 2 bước: login -> selectionToken -> chọn tổ chức -> accessToken.\n- DELETE là soft-delete và trả về HTTP 200 (không phải 204).\n- Backend chưa có GET /testing-units/{id} riêng và chưa có filter ?name= — các case tương ứng dùng GET danh sách.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "adminUsername", "value": "admin" },
		{ "key": "adminPassword", "value": "admin123" },
		{ "key": "managerUsername", "value": "cm_tc" },
		{ "key": "managerPassword", "value": "admin123" }
	],
	"item": [
		{
			"name": "Setup - Authentication",
			"item": [
				{
					"name": "01. Login Admin (VT-01)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"Has selectionToken\", () => pm.expect(body.data.selectionToken).to.be.a('string').and.not.empty);",
									"pm.environment.set(\"selectionToken\", body.data.selectionToken);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
					}
				},
				{
					"name": "02. Get My Organizations",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"Has at least one organization with roleCode\", () => {",
									"    pm.expect(body.data).to.be.an('array').with.length.above(0);",
									"    pm.expect(body.data[0].roleCode).to.exist;",
									"});",
									"pm.environment.set(\"orgId\", body.data[0].organizationId);",
									"console.log('Selected org:', body.data[0].organizationCode, 'role:', body.data[0].roleCode);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{selectionToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/v1/auth/organizations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "organizations"] }
					}
				},
				{
					"name": "03. Select Organization (get Access Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"Has accessToken\", () => pm.expect(body.data.accessToken).to.be.a('string').and.not.empty);",
									"pm.test(\"Role is VT-01 for admin flow\", () => pm.expect(body.data.user.roleCode).to.eql('VT-01'));",
									"pm.environment.set(\"accessToken\", body.data.accessToken);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{selectionToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": { "mode": "raw", "raw": "{\n    \"organizationId\": \"{{orgId}}\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/v1/auth/select-organization", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "select-organization"] }
					}
				}
			]
		},
		{
			"name": "Testing Units - VT-01 CRUD",
			"item": [
				{
					"name": "04. Create Testing Unit (VT-01)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test(\"Returns id and name\", () => {",
									"    pm.expect(body.data.id).to.exist;",
									"    pm.expect(body.data.name).to.eql('Postman Test Lab');",
									"});",
									"pm.test(\"isActive defaults to true\", () => pm.expect(body.data.isActive).to.eql(true));",
									"pm.environment.set(\"createdUnitId\", body.data.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json; charset=utf-8" }
						],
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"Postman Test Lab\",\n    \"accreditationCode\": \"PM-TEST-001\",\n    \"contactInfo\": \"090 000 0000, 1 Postman Street, Q1, TP.HCM\",\n    \"accreditationExpiryDate\": \"2029-12-31\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/v1/testing-units", "host": ["{{baseUrl}}"], "path": ["api", "v1", "testing-units"] }
					}
				},
				{

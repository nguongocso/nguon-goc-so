					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"Contact info updated correctly\", () => {",
									"    pm.expect(body.data.contactInfo).to.eql('098 111 2222, Updated by Postman');",
									"});",
									"pm.test(\"Name unchanged\", () => pm.expect(body.data.name).to.eql('Postman Test Lab'));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json; charset=utf-8" }
						],
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"Postman Test Lab\",\n    \"accreditationCode\": \"PM-TEST-001\",\n    \"contactInfo\": \"098 111 2222, Updated by Postman\",\n    \"accreditationExpiryDate\": \"2029-12-31\",\n    \"isActive\": true\n}" },
						"url": { "raw": "{{baseUrl}}/api/v1/testing-units/{{createdUnitId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "testing-units", "{{createdUnitId}}"] }
					}
				},
				{
					"name": "12. Soft Delete Testing Unit (VT-01)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200 (soft delete, not 204)\", () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/v1/testing-units/{{createdUnitId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "testing-units", "{{createdUnitId}}"] }
					}
				},
				{
					"name": "13. Verify Soft Delete (unit removed from active list)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"const deletedId = pm.environment.get(\"createdUnitId\");",
									"const activeItems = pm.response.json().data.items.filter((u) => u.isActive === true);",
									"pm.test(\"Deleted unit is not in active list anymore\", () => {",
									"    pm.expect(activeItems.map((u) => u.id)).to.not.include(deletedId);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/testing-units?isActive=true&page=0&size=50",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "testing-units"],
							"query": [
								{ "key": "isActive", "value": "true" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "50" }
							]
						}
					}
				}
			]
